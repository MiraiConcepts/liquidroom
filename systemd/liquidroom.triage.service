# Class: scheduled  (see systemd/policy/20-scheduled.conf)
# Family: intake    (see systemd/policy/30-intake.conf)
# Base:             (see systemd/policy/10-base.conf)
#
# Inherited and therefore NOT repeated here: OnFailure, Type, journal logging,
# the base hardening, the intake sandbox and its three InaccessiblePaths, and
# Environment=PATH.
#
# CLASS CHANGED adhoc -> scheduled on 2026-08-28, with the trigger. Requests are
# empty FOLDERS now and no .path verb can watch for emptiness, so
# liquidroom.triage.timer replaced liquidroom.triage.path — see that file. Three
# consequences, all deliberate:
#
#   - MaxAge= and Freshness= are now REQUIRED where adhoc forbade the first. This
#     is a net GAIN: the watchdog could previously only ask "is the watcher
#     armed", and can now ask "did this actually run", which is the stronger
#     question.
#   - The adhoc class's StartLimitIntervalSec=1800 / StartLimitBurst=12 are gone
#     with it. They existed to bound a .path unit that re-fires while its glob
#     still matches; with no .path unit there is no such loop, and a timer cannot
#     start more often than its own schedule. Deleted knowingly, not dropped.
#   - flock -n in the script is what makes a 5-minute poll safe against a 45-minute
#     job: a poll that lands mid-run fails the lock instantly and exits 0.
#
# DOCKER SOCKET NOTE. This job drives `docker compose run` as carrein (docker
# group via initgroups). ProtectSystem=strict does not block connect() on
# /run/docker.sock — measured for changedetection.health, which has run
# docker exec under the same sandbox since the monitor class existed. Socket
# access is root-equivalent, so for THIS unit the intake InaccessiblePaths are
# a tripwire rather than a wall; the same trade changedetection.health made.
#
# The job container runs in dockerd's cgroup, NOT this unit's, so the timeout
# here bounds the SCRIPT only. The script wraps each container stage in its own
# `timeout`, runs the container under a fixed name (liquidroom-job), removes a
# stale one at entry, and removes it again in an EXIT trap — those four layers
# are what actually bound the container.

[Unit]
Description=Liquidroom triage (request marker -> soulseek download -> stems)
After=network-online.target docker.service
Wants=network-online.target
# Stated here although the base sets zfs-mount too: this job polls a Syncthing
# folder and must not be weaker than the mount it reads. docker is load-bearing
# — both pipeline stages are container runs.
Requires=zfs-mount.service docker.service

[Service]
User=carrein
Group=carrein
WorkingDirectory=/zpool/catallenya/liquidroom
Environment=HOME=/home/carrein

# Soulseek credentials. Root-owned 0600, read by systemd (PID 1) and injected
# here, so they are never in a carrein-readable file. No `-` prefix: a missing
# file must fail the unit loudly, not run a triage that cannot download.
EnvironmentFile=/etc/liquidroom.env

# Worst-case batch: MAX_PER_RUN=3 x (15min download + 90min process) = 5h15m,
# plus the 3min Syncthing quiet-wait and margin. The 90min comes from a MEASURED
# 31min for a 3:20 track (~9.4x realtime on this CPU — separation is genuinely
# slow here, and no setting makes it faster: overlap is already at its floor).
# A typical single request is ~35min; the stage `timeout`s inside the script
# bound each container long before this ceiling does.
TimeoutStartSec=6h

ExecStart=/zpool/catallenya/liquidroom/scripts/liquidroom.triage.sh

ReadWritePaths=/zpool/catallenya/syncthing/data/master/liquidroom
ReadWritePaths=/zpool/catallenya/liquidroom/state

[X-Catallenya]
Class=scheduled
Family=intake
# Every 5 minutes with 1 minute of jitter. 1h is twelve missed polls — generous
# enough that a single hiccup is not an alarm, tight enough that a wedged timer
# is caught the same morning rather than a day later.
MaxAge=1h
# No natural artifact: a poll that finds no empty request folder writes nothing,
# which is also why it is silent when healthy. Hence a completion stamp, written
# by 10-base.conf's ExecStartPost= and therefore only on a run that succeeded.
Freshness=stamp:/zpool/catallenya/systemd/state/liquidroom.triage
Producer=container:syncthing
